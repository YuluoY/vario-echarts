{
  "name": "@variojs/core",
  "version": "0.1.9",
  "description": "Vario Core Runtime - Instruction VM, Expression System, Runtime Context",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "types": "./dist/compiler.d.ts"
    },
    "./expression": {
      "import": "./dist/expression.js",
      "types": "./dist/expression.d.ts"
    },
    "./vm": {
      "import": "./dist/vm.js",
      "types": "./dist/vm.d.ts"
    },
    "./schema-tools": {
      "import": "./dist/schema-tools.js",
      "types": "./dist/schema-tools.d.ts"
    }
  },
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "@babel/types": "^7.23.6",
    "@variojs/types": "workspace:*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}